{
  "info": {
    "name": "Rental Taxi API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register Customer",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"cust1\",\n  \"password\": \"pass123\",\n  \"email\": \"cust1@example.com\",\n  \"fullName\": \"Customer One\",\n  \"phone\": \"1111111111\",\n  \"address\": \"123 Main St\"\n}"
        },
        "url": "http://localhost:8080/auth/register/customer"
      }
    },
    {
      "name": "2. Login Customer (Auto-save token)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"cust1\",\n  \"password\": \"pass123\"\n}"
        },
        "url": "http://localhost:8080/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.response.code === 200) {",
            "    const response = pm.response.json();",
            "    pm.collectionVariables.set('customerToken', response.token);",
            "    console.log('✅ Customer token saved');",
            "}"
          ]
        }
      }]
    },
    {
      "name": "3. Get My Profile (Customer)",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{customerToken}}"}],
        "url": "http://localhost:8080/customers/me"
      }
    },
    {
      "name": "4. Create Booking (Customer)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{customerToken}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pickupLocation\": \"Airport T1\",\n  \"dropoffLocation\": \"City Center\",\n  \"pickupTime\": \"2026-07-30T10:30:00\"\n}"
        },
        "url": "http://localhost:8080/bookings"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.response.code === 200) {",
            "    const jsonData = pm.response.json();",
            "    pm.collectionVariables.set('bookingId', jsonData.bookingId);",
            "    console.log('✅ Booking ID: ' + jsonData.bookingId);",
            "}"
          ]
        }
      }]
    },
    {
      "name": "5. Login Admin (Auto-save token)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "http://localhost:8080/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.response.code === 200) {",
            "    const response = pm.response.json();",
            "    pm.collectionVariables.set('adminToken', response.token);",
            "    console.log('✅ Admin token saved');",
            "}"
          ]
        }
      }]
    },
    {
      "name": "6. Create Driver (Admin only)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{adminToken}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"driver1\",\n  \"password\": \"driver123\",\n  \"email\": \"driver1@example.com\",\n  \"fullName\": \"Driver One\",\n  \"phone\": \"3333333333\",\n  \"licenseNumber\": \"DL123456\",\n  \"status\": \"AVAILABLE\"\n}"
        },
        "url": "http://localhost:8080/auth/register/driver"
      }
    },
    {
      "name": "7. Login Driver (Auto-save token)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"driver1\",\n  \"password\": \"driver123\"\n}"
        },
        "url": "http://localhost:8080/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.response.code === 200) {",
            "    const response = pm.response.json();",
            "    pm.collectionVariables.set('driverToken', response.token);",
            "    console.log('✅ Driver token saved');",
            "}"
          ]
        }
      }]
    },
    {
      "name": "8. Create Cab (Admin only)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{adminToken}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"plateNumber\": \"MH12AB1234\",\n  \"model\": \"Toyota Innova\",\n  \"capacity\": 7,\n  \"status\": \"AVAILABLE\"\n}"
        },
        "url": "http://localhost:8080/cabs"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.response.code === 200) {",
            "    const jsonData = pm.response.json();",
            "    pm.collectionVariables.set('cabId', jsonData.cabId);",
            "    console.log('✅ Cab ID: ' + jsonData.cabId);",
            "}"
          ]
        }
      }]
    },
    {
      "name": "9. Accept Booking (Driver)",
      "request": {
        "method": "PUT",
        "header": [{"key": "Authorization", "value": "Bearer {{driverToken}}"}],
        "url": "http://localhost:8080/bookings/{{bookingId}}/accept"
      }
    },
    {
      "name": "10. Complete Booking (Driver)",
      "request": {
        "method": "PUT",
        "header": [{"key": "Authorization", "value": "Bearer {{driverToken}}"}],
        "url": "http://localhost:8080/bookings/{{bookingId}}/complete"
      }
    },
    {
      "name": "11. Process Payment (Customer)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{customerToken}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 350.50,\n  \"method\": \"CARD\"\n}"
        },
        "url": "http://localhost:8080/payments/booking/{{bookingId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.response.code === 200) {",
            "    pm.collectionVariables.set('paymentId', pm.response.json().paymentId);",
            "    console.log('✅ Payment ID: ' + pm.response.json().paymentId);",
            "}"
          ]
        }
      }]
    },
    {
      "name": "12. Add Feedback (Customer)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{customerToken}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Excellent ride!\"\n}"
        },
        "url": "http://localhost:8080/feedbacks/booking/{{bookingId}}"
      }
    },
    {
      "name": "13. Get All Cabs (Customer)",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{customerToken}}"}],
        "url": "http://localhost:8080/cabs"
      }
    }
  ],
  "variable": [
    {"key": "customerToken", "value": ""},
    {"key": "adminToken", "value": ""},
    {"key": "driverToken", "value": ""},
    {"key": "bookingId", "value": ""},
    {"key": "cabId", "value": ""},
    {"key": "paymentId", "value": ""}
  ]
}